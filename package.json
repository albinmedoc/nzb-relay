{
  "name": "nzb-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm run build:shared && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "pnpm run build:server && pnpm run build:frontend",
    "build:shared": "pnpm --filter @nzb-relay/shared build",
    "build:server": "pnpm run build:shared && tsc -p tsconfig.build.json",
    "build:frontend": "pnpm --filter nzb-relay-frontend build",
    "dev:frontend": "pnpm --filter nzb-relay-frontend dev",
    "test": "pnpm run build:shared && vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@nzb-relay/shared": "workspace:*",
    "@hono/node-server": "^1.13.8",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.4",
    "fast-xml-parser": "^4.5.1",
    "hono": "^4.6.16",
    "pino": "^9.5.0",
    "proper-lockfile": "^4.1.2",
    "undici": "^7.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/proper-lockfile": "^4.1.4",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
